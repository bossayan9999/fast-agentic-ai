# ═══════════════════════════════════════════════════════════
# OpenRouter API Key (REQUIRED for chat)
# Get yours here (free to create): https://openrouter.ai/keys
# Docs: https://openrouter.ai/docs
# ═══════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional model (default: anthropic/claude-3.5-sonnet)
# Browse models: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: GitHub token for Obsidian vault search/save
# Create PAT: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=bossayan9999
GITHUB_REPO=fast-agentic-ai

# Dedicated vault repo
VAULT_OWNER=bossayan9999
VAULT_REPO=obsidian-agent-vault
VAULT_PATH=

# App URL (OpenRouter HTTP-Referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000
