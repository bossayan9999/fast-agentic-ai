# Required: Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model to use (default: anthropic/claude-3.5-sonnet)
# Popular: openai/gpt-4o, google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: for GitHub Backup Repo / memory features
# Create a fine-grained or classic PAT with repo scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=bossayan9999
GITHUB_REPO=fast-agentic-ai

# Dedicated Obsidian-style vault (created for you)
VAULT_OWNER=bossayan9999
VAULT_REPO=obsidian-agent-vault
# Leave empty to use vault repo root, or set e.g. "notes"
VAULT_PATH=

# App URL (for OpenRouter referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000
