{
  "name": "fast-agentic-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx @cloudflare/next-on-pages",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static --project-name=fast-agentic-ai",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name=fast-agentic-ai",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "openai": "^4.77.0",
    "@octokit/rest": "^21.0.2",
    "uuid": "^11.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "@cloudflare/next-on-pages": "^1.13.5",
    "wrangler": "^3.99.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0"
  }
}
